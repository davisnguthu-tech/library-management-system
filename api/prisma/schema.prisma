generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATRON
  LIBRARIAN
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(PATRON)
  createdAt DateTime @default(now())
  reviews   Review[]
}

model Genre {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  books     Book[]
  createdAt DateTime @default(now())
}

model Book {
  id          Int      @id @default(autoincrement())
  title       String
  author      String
  description String?
  published   Boolean  @default(true)
  isbn        String?  @unique
  totalCopies Int      @default(5)
  genreId     Int
  genre       Genre    @relation(fields: [genreId], references: [id])
  reviews     Review[]
  createdAt   DateTime @default(now())
}

model Review {
  id        Int      @id @default(autoincrement())
  bookId    Int
  userId    Int
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  book      Book     @relation(fields: [bookId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}